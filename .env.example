# Ankr Web3 API — one key covers EVM + Solana.
# Public endpoints work without a key (rate-limited).
# Get a key: https://www.ankr.com/rpc/
ANKR_API_KEY=

# Agent service
AGENT_PORT=8787
AGENT_HOST=127.0.0.1

# Optional overrides (otherwise derived from ANKR_API_KEY)
# ETH_RPC_URL=https://rpc.ankr.com/eth
# SEPOLIA_RPC_URL=https://rpc.ankr.com/eth_sepolia
# BASE_RPC_URL=https://rpc.ankr.com/base
# BASE_SEPOLIA_RPC_URL=https://rpc.ankr.com/base_sepolia
# SOLANA_RPC_URL=https://rpc.ankr.com/solana
# SOLANA_DEVNET_RPC_URL=https://rpc.ankr.com/solana_devnet

# Local signing (dev only — never commit real keys)
# EVM_PRIVATE_KEY=
# SOLANA_KEYPAIR_PATH=~/.config/solana/id.json
